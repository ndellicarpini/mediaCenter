{
    "id": "dolphin",
    "name": "Dolphin",
    "className": "DolphinEmulator",

    "exe": "Dolphin.exe",
    "dir": "C:\\Emulators\\Dolphin",

    "requireFullscreen": true,
    "priority": "H",

    "numStates": 1,

    "controls": ["Xbox Controller"],

    "hotkeys": {
        "xinput": {
            "HOME&START": "program.saveState",
            "HOME&SELECT": "program.loadState",
            "HOME&RT>0.3": "program.fastForward"
        },
        "keyboard": {
            "blockKeyboard": false,
            "blockMouse": true,
            "TAB&1": "program.saveState",
            "TAB&5": "program.loadState",
            "TAB&NumpadEnter": "program.fastForward"
        }
    },

    "pauseHotkey": "{F10}",
    "saveStateHotkey": ["{Shift down}", "{F1}", "{Shift up}"],
    "loadStateHotkey": "{F1}",
    "resetHotkey": "-",
    "fastForwardHotkey": "=",
    "fastForwardHold": true
}