{
    "id": "kodi",
	"name": "Kodi",
    "className": "KodiProgram",

    "enabled": false,
    "dir": "C:\\Kodi",
    "exe": "kodi.exe",
    "defaultArgs": "-fs -p",

    "enableVPN": "expressVPNConnect",
    "disableVPN": "expressVPNDisconnect",
    "checkVPN": "expressVPNConnected",

    "requireFullscreen": true,
    "allowQuickAccess": false,
    "allowExit": false,

    "pauseOptions": {
        "Toggle VPN": "program.toggleVPN",
        "Reload": "program.reload"
    },

    "pauseOrder": [
        "Toggle VPN",
        "Reload"
    ]
}