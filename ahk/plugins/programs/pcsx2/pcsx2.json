{
    "id": "pcsx2",
    "name": "PCSX2",
    "className": "PCSX2Emulator",

    "exe": "pcsx2-qt.exe",
    "dir": "C:\\Emulators\\PCSX2",

    "requireFullscreen": true,
    "overlayActivateFix": true,
    "priority": "H",

    "numStates": 1,
    "fastForward": true,
    "reset": true,

    "controls": ["Xbox Controller"],

    "hotkeys": {
        "xinput": {
            "HOME&START": "program.saveState",
            "HOME&SELECT": "program.loadState",
            "HOME&RT>0.3": "program.fastForward"
        },
        "keyboard": {
            "blockKeyboard": false,
            "blockMouse": true,
            "TAB&1": "program.saveState",
            "TAB&5": "program.loadState",
            "TAB&NumpadEnter": "program.fastForward"
        }
    },

    "pauseHotkey": "0",
    "saveStateHotkey": "{F1}",
    "loadStateHotkey": "{F3}",
    "resetHotkey": "-",
    "fastForwardHotkey": "="
}