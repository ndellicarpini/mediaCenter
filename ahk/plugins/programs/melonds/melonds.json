{
    "id": "melonds",
    "name": "MelonDS",
    "className": "MelonDSEmulator",

    "enabled": false,
    "exe": "melonDS.exe",
    "dir": "C:\\Emulators\\MelonDS",

    "requireFullscreen": true,

    "mouseMoveDelay": 500,
    "fullscreenDelay": 500,

    "numStates": 1,
    "fastForward": true,
    "reset": true,

    "controls": ["Xbox Controller"],

    "mouse": {
        "initialPos": [0.875, 0.5],
        "xinput": {
            "x": "RSX",
            "y": "-RSY",
            "lclick": "RSB",
            "deadzone": 0.15
        }
    },

    "hotkeys": {
        "buttonTime": 0,
        "xinput": {
            "HOME&START": {
                "down": "program.saveState",
                "time": 70
            },
            "HOME&SELECT": {
                "down": "program.loadState",
                "time": 70
            },
            "HOME&RT>0.3": {
                "down": "program.fastForward",
                "time": 70
            }
        }
    },

    "pauseOptions": {
        "Swap Screen Position": "program.swapScreenPos",
        "Swap Screen Size": "program.swapScreenSize"
    },

    "pauseOrder": [
        "Save State", 
        "Load State", 
        "Swap Screen Position", 
        "Swap Screen Size", 
        "Reset Game"
    ]
}