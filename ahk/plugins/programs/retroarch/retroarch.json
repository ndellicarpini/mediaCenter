{
    "id": "retroarch",
    "name": "RetroArch",
    "className": "RetroArchEmulator",

    "exe": "retroarch.exe",
    "dir": "C:\\Emulators\\RetroArch",

    "requireFullscreen": true,
    "overlayActivateFix": true,
    "priority": "H",

    "numStates": 1,

    "controls": ["Xbox Controller"],

    "hotkeys": {
        "xinput": {
            "HOME&START": "program.saveState",
            "HOME&SELECT": "program.loadState",
            "HOME&LT>0.3": "program.rewind",
            "HOME&RT>0.3": "program.fastForward"
        },
        "keyboard": {
            "blockKeyboard": false,
            "blockMouse": true,
            "TAB&1": "program.saveState",
            "TAB&5": "program.loadState",
            "TAB&NumpadEnter": "program.fastForward"
        }
    },

    "pauseOptions": {
        "Toggle Menu": "program.menu"
    },

    "pauseOrder": [
        "Save State", 
        "Load State", 
        "Reset Game",
        "Toggle Menu"
    ],

    "pauseHotkey": "0",
    "saveStateHotkey": "{F2}",
    "loadStateHotkey": "{F4}",
    "resetHotkey": "-",
    "fastForwardHotkey": "="
}