{
    "id": "xemu",
    "name": "Xemu",
    "className": "XemuEmulator",

    "exe": "xemu.exe",
    "dir": "C:\\Emulators\\Xemu",
    "defaultArgs": "-full-screen -dvd_path",

    "requireFullscreen": true,
    "overlayActivateFix": true,
    "priority": "H",

    "reset": true,

    "controls": ["Xbox Controller"],

	"hotkeys": {
        "keyboard": {
            "vinput": [
                {
                    "Up": "DU",
                    "Down": "DD",
                    "Left": "DL",
                    "Right": "DR",
                    "C": "A",
                    "J": "A",
                    "LControl": "A",
                    "V": "B",
                    "L": "B",
                    "LAlt": "B",
                    "LShift": "X",
                    "Z": "Y",
                    "Space": "LB",
                    "X": "RB",
                    "1": "START",
                    "NumpadEnter": "START",
                    "5": "SELECT"
                },
                {
                    "R": "DU",
                    "F": "DD",
                    "D": "DL",
                    "G": "DR",
                    "A": "A",
                    "S": "B",
                    "W": "X",
                    "I": "Y",
                    "Q": "LB",
                    "K": "RB",
                    "2": "START",
                    "6": "SELECT"
                }
            ]
        }
    },

    "pauseHotkey": ["{Ctrl down}", "p", "{Ctrl up}"],
    "resetHotkey": ["{Ctrl down}", "r", "{Ctrl up}"]
}