{
    "id": "chrome",
    "name": "Google Chrome",
    "className": "ChromeProgram",

    "requireFullscreen": true,
    "keyboardMode": "Windows",

    "dir": "C:\\Program Files\\Google\\Chrome\\Application\\",
    "exe": "chrome.exe",
    "overlay": "Picture in picture",

    "mouseMoveDelay": 100,
    "fullscreenDelay": 100,

    "mouse": {
        "initialPos": [0.5, 0.5],
        "xinput": {
            "x": "LSX",
            "y": "-LSY",
            "vscroll": "-RSY",
            "lclick": "A",
            "rclick": "X",
            "deadzone": 0.15
        }
    },

    "hotkeys": {
        "buttonTime": 0,
        "xinput": {
            "[REPEAT]RSX>0.75": "program.zoomIn",
            "[REPEAT]RSX<-0.75": "program.zoomOut",

            "[REPEAT]DU": "Send {Up}",
            "[REPEAT]DD": "Send {Down}",
            "[REPEAT]DL": "Send {Left}",
            "[REPEAT]DR": "Send {Right}",

            "[REPEAT]B": "Send {Backspace}",
            "Y": "Send !{Home}",
            "LB": "Send ^+{Tab}",
            "RB": "Send ^{Tab}",
            "LT>0.75": "Send !{Left}",
            "RT>0.75": "Send !{Right}",

            "SELECT": {
                "down": "toggleKeyboard",
                "time": 70
            },
            "START": {
                "down": "Send ^t",
                "time": 70
            }
        },
        "keyboard": {
            "vinput": [
                {
                    "Up": "DU",
                    "Down": "DD",
                    "Left": "DL",
                    "Right": "DR",
                    "C": "A",
                    "J": "A",
                    "LControl": "A",
                    "V": "B",
                    "L": "B",
                    "LAlt": "B",
                    "LShift": "X",
                    "Z": "Y",
                    "Space": "LB",
                    "X": "RB",
                    "1": "START",
                    "NumpadEnter": "START",
                    "5": "SELECT"
                },
                {
                    "R": "DU",
                    "F": "DD",
                    "D": "DL",
                    "G": "DR",
                    "A": "A",
                    "S": "B",
                    "W": "X",
                    "I": "Y",
                    "Q": "LB",
                    "K": "RB",
                    "2": "START",
                    "6": "SELECT"
                }
            ]
        }
    },

    "pauseOptions": {
        "Toggle Picture-in-Picture": "program.pip"
    },
    "pauseOrder": ["Toggle Picture-in-Picture"]
}