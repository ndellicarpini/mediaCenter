{
    "id": "ppsspp",
    "name": "PPSSPP",
    "className": "PPSSPPEmulator",

    "exe": "PPSSPPWindows64.exe",
    "dir": "C:\\Emulators\\PPSSPP",

    "requireFullscreen": true,

    "numStates": 1,
    "fastForward": true,
    "reset": true,

    "controls": ["Xbox Controller"],

    "hotkeys": {
        "xinput": {
            "HOME&START": "program.saveState",
            "HOME&SELECT": "program.loadState",
            "HOME&RT>0.3": "program.fastForward"
        },
        "keyboard": {
            "blockKeyboard": false,
            "blockMouse": true,
            "TAB&1": "program.saveState",
            "TAB&5": "program.loadState",
            "TAB&NumpadEnter": "program.fastForward"
        }
    },

    "pauseHotkey": "0",
    "saveStateHotkey": "{F1}",
    "loadStateHotkey": "{F3}",
    "resetHotkey": "-",
    "fastForwardHotkey": "=",
    "fastForwardHold": true
}