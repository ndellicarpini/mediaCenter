{
    "id": "xinput",
    "name": "Xbox Controller",
    "className": "XInputDevice",

    "enabled": false,
    "maxConnected": 4,
    "vibration": true,

    "buttons": ["A", "B", "X", "Y", "LB", "RB", "SELECT", "START", "LSB", "RSB", "DU", "DD", "DL", "DR", "HOME"],
    "axis": ["LSX", "LSY", "RSX", "RSY", "LT", "RT"],

    "default": {
        "hotkeys": {
            "HOME": {
                "up": "pausemenu",
                "time": 100
            },
            "START&SELECT": {
                "down": "program.exit",
                "time": 100
            },
            "[PATTERN]HOME&RSY>0.7,HOME&RSY>0.7,HOME&RSY<-0.7,HOME&RSY<-0.7,HOME&RSX<-0.7,HOME&RSX>0.7,HOME&RSX<-0.7,HOME&RSX>0.7,HOME&B,HOME&A,HOME&START": "enableDesktopMode",
            "[PATTERN]HOME&RSY>0.7,HOME&RSY>0.7,HOME&RSY<-0.7,HOME&RSY<-0.7,HOME&RSX<-0.7,HOME&RSX>0.7,HOME&RSX<-0.7,HOME&RSX>0.7,HOME&B,HOME&A,HOME&SELECT": "Shutdown 2"
        }
    },

    "kbmmode": {
        "hotkeys": {
            "SELECT": "toggleKeyboard",
            "[REPEAT]B": "Send {Backspace}"
        },
        "mouse": {
            "x": "LSX", 
            "y": "-LSY", 
            "lclick": "A",
            "rclick": "X",
            "hscroll": "RSX",
            "vscroll": "-RSY"
        }
    },

    "desktopmode": {
        "hotkeys": {
            "HOME": {
                "up": "pausemenu",
                "time": 100
            },
            
            "SELECT": "toggleKeyboard",
            "START": "Send {LWin}",

            "[REPEAT]DU": "Send {Up}",
            "[REPEAT]DD": "Send {Down}",
            "[REPEAT]DL": "Send {Left}",
            "[REPEAT]DR": "Send {Right}",

            "[REPEAT]B": "Send {Backspace}",

            "LT>0.3": "desktopAltTab",
            "RT>0.3": {
                "down": "desktopAltDown",
                "up": "desktopAltUp"
            }
        },
        "mouse": {
            "x": "LSX", 
            "y": "-LSY", 
            "lclick": "A",
            "rclick": "X",
            "hscroll": "RSX",
            "vscroll": "-RSY"
       }
    },

    "interfaceHotkeys": {
        "default": {
            "[REPEAT]DU|LSY>0.4": "gui.up",
            "[REPEAT]DD|LSY<-0.4": "gui.down",
            "[REPEAT]DL|LSX<-0.4": "gui.left",
            "[REPEAT]DR|LSX>0.4": "gui.right",
            "HOME": "pausemenu",
            "B": "gui.back",
            "A": {
                "down": "gui.select",
                "up": "gui.unselect"
            }
        },
        "keyboard": {
            "X": "gui.keyboard space",
            "Y": "gui.keyboard caps",
            "LB": "gui.cursorLeft",
            "RB": "gui.cursorRight",
            "SELECT": "gui.Destroy",
            "START": "gui.sendText",
            "LT>0.1": {
                "down": "gui.keyboard ctrl",
                "up": "gui.keyboard ctrl"
            },
            "RT>0.1": {
                "down": "gui.keyboard shift",
                "up": "gui.keyboard shift"
            }
        }
    }
}